# ==========================================
# Tauri 2 Subagents Pack - .gitignore
# ==========================================

# Temporary files & locks generated by installer
*.tmp
.tauri-pack-*
.tauri-pack.lock

# Test artifacts & temporary logs
*.log
!reports/*.log
reports/*.tmp

# Backups generated on local machines during install
backups/

# System & OS files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Editor & IDE settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
